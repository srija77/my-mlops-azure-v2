# Copy to .env and fill in. .env is gitignored — the endpoint key is a credential.
#
#   az ml online-endpoint show -n dam-mcp-endpoint \
#     -g rg-energy-mlops -w mlw-energy-forecast --query scoring_uri -o tsv
AML_ENDPOINT_URL=https://dam-mcp-endpoint.eastus.inference.ml.azure.com/score

#   az ml online-endpoint get-credentials -n dam-mcp-endpoint \
#     -g rg-energy-mlops -w mlw-energy-forecast --query primaryKey -o tsv
AML_ENDPOINT_KEY=

# Pins requests to one deployment. Leave blank to honour the endpoint traffic split.
AML_DEPLOYMENT=champion

LOG_LEVEL=INFO
